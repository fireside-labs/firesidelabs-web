{
  "redirects": [
    { "source": "/solutions", "destination": "/services", "permanent": true },
    { "source": "/calibration", "destination": "/services", "permanent": true },
    { "source": "/security", "destination": "/services", "permanent": true },
    { "source": "/foundry", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!papers/|film/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/film/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
