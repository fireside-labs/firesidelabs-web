{
  "redirects": [
    {
      "source": "/solutions",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/calibration",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/foundry",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/wayward/privacy",
      "destination": "/wayward/privacy.html"
    },
    {
      "source": "/wayward/terms",
      "destination": "/wayward/terms.html"
    },
    {
      "source": "/wayward/support",
      "destination": "/wayward/support.html"
    },
    {
      "source": "/((?!$|papers/|film/|home/|forge/|wayward/|assets/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/forge/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/home/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/film/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
